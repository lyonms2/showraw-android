<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ShowRaw"
            android:textColor="@color/primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Fase 1 — Prova de conceito de áudio"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- ── Validação de hardware ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="VALIDAÇÃO DE HARDWARE"
            android:textColor="@color/primary_light"
            android:textSize="11sp"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/tv_hw_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/bg_card"
            android:padding="14dp"
            android:text="Pressione o botão para validar."
            android:textColor="@color/white"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_validate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/bg_card_active"
            android:text="Validar Hardware"
            android:textColor="@color/primary"
            android:textStyle="bold" />

        <!-- ── Divider ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:background="@color/border" />

        <!-- ── Gravação ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GRAVAÇÃO DE ÁUDIO"
            android:textColor="@color/primary_light"
            android:textSize="11sp"
            android:letterSpacing="0.12" />

        <!-- VU bar -->
        <ProgressBar
            android:id="@+id/vu_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="14dp"
            android:max="96"
            android:progress="0"
            android:progressTint="@color/vu_green" />

        <!-- Stats grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/bg_card"
            android:padding="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Peak"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_peak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— dBFS"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Limiter GR"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_gr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 dB"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Preset"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_preset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎸 Show / Concerto"
                    android:textColor="@color/primary_light"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_record"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/primary"
            android:text="● Iniciar Gravação"
            android:textColor="@color/bg_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- SPL warning -->
        <TextView
            android:id="@+id/tv_spl_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/alert_red"
            android:padding="12dp"
            android:text="⚠ Volume muito alto para o microfone interno.\nO limiter não consegue recuperar este sinal."
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Arquivo exportado -->
        <TextView
            android:id="@+id/tv_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/bg_card"
            android:padding="14dp"
            android:textColor="@color/vu_green"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
