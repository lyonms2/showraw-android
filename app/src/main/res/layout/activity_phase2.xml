<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Viewfinder da câmera — fundo completo -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- VU meter — tira fina no topo -->
    <ProgressBar
        android:id="@+id/vu_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:max="96"
        android:progress="0"
        android:progressTint="@color/vu_green"
        android:progressBackgroundTint="#33FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Badge RAW + REC + Timer — topo esquerdo -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/vu_bar"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#CC000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="RAW"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tv_rec_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#CC000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="⬤ REC"
            android:textColor="@color/alert_red"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#CC000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Overlay escuro no rodapé -->
    <View
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="#CC0D0D0D"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Stats: Peak + GR -->
    <LinearLayout
        android:id="@+id/stats_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="76dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PEAK"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_peak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— dBFS"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIMITER GR"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_gr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 dB"
                android:textColor="@color/primary_light"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRESET"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_preset_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show"
                android:textColor="@color/primary_light"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botão gravar -->
    <Button
        android:id="@+id/btn_record"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/primary"
        android:text="● Iniciar Gravação"
        android:textColor="@color/bg_main"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Overlay de exportação -->
    <LinearLayout
        android:id="@+id/export_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E60D0D0D"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Processando áudio…"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/export_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="20dp"
            android:max="100"
            android:progressTint="@color/primary" />

        <TextView
            android:id="@+id/tv_export_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Codificando AAC…"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Resultado final -->
        <TextView
            android:id="@+id/tv_export_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/bg_card"
            android:padding="14dp"
            android:textColor="@color/vu_green"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_nova_gravacao"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/primary"
            android:text="Nova Gravação"
            android:textColor="@color/bg_main"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- SPL warning overlay -->
    <TextView
        android:id="@+id/tv_spl_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="180dp"
        android:background="@color/alert_red"
        android:padding="12dp"
        android:text="⚠ Volume muito alto para o microfone interno. Afaste-se da fonte sonora."
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
