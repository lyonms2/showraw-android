<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Camera preview — full screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- VU meter — thin strip at top -->
    <ProgressBar
        android:id="@+id/vu_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:max="96"
        android:progress="0"
        android:progressTint="@color/vu_green"
        android:progressBackgroundTint="#33FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top badge row: RAW + REC + Timer -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/vu_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_group_top">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#CC000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="RAW"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tv_rec_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#CC000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="⬤ REC"
            android:textColor="@color/alert_red"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#CC000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_time_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#CC000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text=""
            android:textColor="#999999"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Info row: resolução · fonte de áudio · armazenamento -->
    <LinearLayout
        android:id="@+id/info_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_group_top">

        <TextView
            android:id="@+id/tv_resolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#CC000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="1080p / 30fps"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_audio_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="#CC000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="MIC INT"
            android:textColor="#999999"
            android:textSize="10sp"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="#CC000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="—"
            android:textColor="#999999"
            android:textSize="10sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Top-right button group: WB · Monitoring · EIS · Flip -->
    <LinearLayout
        android:id="@+id/btn_group_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/vu_bar"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_wb"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#80000000"
            android:text="AWB"
            android:textColor="@color/white"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_monitoring"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#80000000"
            android:text="🎧"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:padding="0dp"
            android:enabled="false"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_stabilization"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#80000000"
            android:text="EIS"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:padding="0dp"
            android:enabled="false" />

        <Button
            android:id="@+id/btn_flip_camera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:backgroundTint="#80000000"
            android:text="⇄"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:padding="0dp"
            android:enabled="false" />

    </LinearLayout>

    <!-- Zoom level badge — center top, hidden until zoomed -->
    <TextView
        android:id="@+id/tv_zoom_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#CC000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="1.0×"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/vu_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Session name input — visível no estado de preview, some ao gravar -->
    <EditText
        android:id="@+id/et_session_name"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="#80000000"
        android:hint="Nome da sessão (opcional)"
        android:textColorHint="#666666"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:paddingHorizontal="12dp"
        android:inputType="text"
        android:maxLines="1"
        android:imeOptions="actionDone"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/info_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Exposure control row — visível durante gravação -->
    <LinearLayout
        android:id="@+id/exposure_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/et_session_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀"
            android:textColor="#999999"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <SeekBar
            android:id="@+id/sb_exposure"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/primary"
            android:thumbTint="@color/primary" />

        <TextView
            android:id="@+id/tv_exposure_val"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="end"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Bottom gradient overlay -->
    <View
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="#CC0D0D0D"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Waveform view — acima da row de stats -->
    <com.showraw.android.ui.recording.WaveformView
        android:id="@+id/waveform_view"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="0dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/stats_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Stats row: PEAK / LIMITER GR / PRESET -->
    <LinearLayout
        android:id="@+id/stats_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btn_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PEAK"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_peak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— dBFS"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMP GR"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_comp_gr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 dB"
                android:textColor="@color/primary_light"
                android:textSize="15sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIM GR"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_gr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 dB"
                android:textColor="@color/primary_light"
                android:textSize="15sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Buttons: Pausar (disabled) + Parar -->
    <LinearLayout
        android:id="@+id/btn_row"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_pause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/bg_card"
            android:text="⏸ Pausar"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:enabled="false" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:backgroundTint="@color/primary"
            android:text="■ Parar"
            android:textColor="@color/bg_main"
            android:textSize="15sp"
            android:textStyle="bold"
            android:enabled="false" />

    </LinearLayout>

    <!-- Finalizing overlay -->
    <LinearLayout
        android:id="@+id/overlay_finalizing"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC0D0D0D"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Finalizando gravação…"
            android:textColor="@color/white"
            android:textSize="14sp" />

    </LinearLayout>


    <!-- SPL extreme warning overlay -->
    <LinearLayout
        android:id="@+id/overlay_spl"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E6000000"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠"
            android:textColor="@color/alert_red"
            android:textSize="44sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Volume muito alto para o microfone interno"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="O limiter não consegue recuperar este sinal.\nConecte um microfone externo ou afaste-se da fonte sonora."
            android:textColor="#BBBBBB"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_spl_continue"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#2A2A2A"
                android:text="Continuar"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_spl_mic"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:backgroundTint="#2A2A2A"
                android:text="Mic Externo"
                android:textColor="@color/primary_light"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_spl_stop"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/alert_red"
                android:text="Parar"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
